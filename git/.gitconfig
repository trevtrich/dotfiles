[user]
    name = Trevor Richardson
	email = trevor@getclaimable.com
	signingkey = CBEDB246266D4DD0

[github]
    user = trevtrich

[init]
    defaultBranch = main
    templatedir = ~/.git_template

[commit]
    gpgsign = true

[diff]
    renames = copy
    tool = vimdiff
    indentHeuristic = true

[merge]
    tool = p4mergetool

[pull]
    rebase = false

[rerere]
    enabled = true

[color]
    ui = true

[color "status"]
    branch = yellow bold
    header = cyan
    added = green
    changed = red
    untracked = magenta

[color "branch"]
    current = green
    local = cyan
    remote = magenta

[color "diff"]
    meta = yellow bold
    whitespace = red reverse

[core]
    autocrlf = input
    longpaths = true
    whitespace=fix,tab-in-indent,trailing-space,cr-at-eol
    excludesfile = ~/.gitignore
    trustctime = false

[push]
    followTags = true

[branch]
    autorebase = always

[alias]
    br = branch
    cm = commit

    # Delete Merged
    dm = !git co main && git rom && git branch --merged origin/main | grep -v main | xargs -n 1 git branch -d

    co = checkout
    hist = log -n 10 --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
    histl = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
    pom = pull origin main
    rom = !git fetch origin && git rebase origin/main
    st = status
    wipe = !git add -A && git commit -qnm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard
    amend = commit -a --amend --no-edit
    fp = push --force-with-lease

[rebase]
    autosquash = true

[include]
    path = ~/.gitconfig.extra
    path = ~/.gitconfig.os

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[coderabbit]
	machineId = cli/c4024bb0ce204773a6d8fa351374e2b9
[url "https://github.com/"]
	insteadOf = git@github.com:
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
